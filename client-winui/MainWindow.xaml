<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ShittimLogonUpdater.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
      背景保持透明，云母（Mica）才能透出来 —— 背景由代码里的
      SystemBackdrop = new MicaBackdrop() 提供，XAML 里不要铺实色。
    -->
    <Grid x:Name="RootGrid" Background="Transparent">

        <!-- 内容整体上浮入场，避免窗口打开时"啪"地一下全部出现 -->
        <Grid.ChildrenTransitions>
            <TransitionCollection>
                <EntranceThemeTransition FromVerticalOffset="24" />
            </TransitionCollection>
        </Grid.ChildrenTransitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ================= 自定义标题栏 =================
             占位与系统的最小化/最大化/关闭按钮同一行，
             右侧的系统按钮区域由 Windows 自己绘制，不要放控件。 -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="48">
            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="18,0,0,0"
                        Spacing="12">
                <FontIcon Glyph="&#xE896;"
                          FontSize="16"
                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                <TextBlock Text="ShittimLogon 更新器"
                           FontSize="12"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- ================= 主内容 ================= -->
        <ScrollViewer Grid.Row="1"
                      Padding="32,4,32,28"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="18"
                        MaxWidth="760"
                        HorizontalAlignment="Stretch">

                <!-- 标题 -->
                <StackPanel Spacing="6">
                    <TextBlock Text="ShittimLogon 更新器"
                               Style="{StaticResource TitleTextBlockStyle}" />
                    <TextBlock Text="自动拉取安装包 → 解压 → 运行其中的 install.exe"
                               Style="{StaticResource BodyTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>

                <!-- 拉取地址 -->
                <StackPanel Spacing="6">
                    <TextBlock Text="拉取地址"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBox x:Name="UrlBox" />
                </StackPanel>

                <!-- 操作 -->
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button x:Name="StartButton"
                            Content="开始"
                            Style="{StaticResource AccentButtonStyle}"
                            MinWidth="112"
                            Click="OnStartClicked" />
                    <Button x:Name="CancelButton"
                            Content="取消"
                            MinWidth="112"
                            IsEnabled="False"
                            Click="OnCancelClicked" />
                </StackPanel>

                <!-- 进度 -->
                <StackPanel Spacing="8">
                    <!-- 注意不要命名为 ProgressBar：那会遮蔽同名的控件类型 -->
                    <ProgressBar x:Name="Progress" />
                    <TextBlock x:Name="StatusText"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="就绪"
                               TextWrapping="Wrap" />
                </StackPanel>

                <!-- 日志 -->
                <StackPanel Spacing="6">
                    <TextBlock Text="日志"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Border CornerRadius="8"
                            BorderThickness="1"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                        <ListView x:Name="LogList"
                                  Height="190"
                                  Padding="4"
                                  SelectionMode="None"
                                  IsItemClickEnabled="False" />
                    </Border>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
