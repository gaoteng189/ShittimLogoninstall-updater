<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ShittimLogonSender.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- 背景透明让 Mica 云母透出来；背景由代码里的 SystemBackdrop 提供 -->
    <Grid x:Name="RootGrid" Background="Transparent">

        <Grid.ChildrenTransitions>
            <TransitionCollection>
                <EntranceThemeTransition FromVerticalOffset="24" />
            </TransitionCollection>
        </Grid.ChildrenTransitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ================= 自定义标题栏 ================= -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="48">
            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="18,0,0,0"
                        Spacing="12">
                <FontIcon Glyph="&#xE898;"
                          FontSize="16"
                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                <TextBlock Text="ShittimLogon 发送端"
                           FontSize="12"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- ================= 主内容 =================
             与客户端同理：外层用 Grid，列宽由可用空间决定，不受子元素影响；
             不给 MaxWidth、不加 Center，内容左端起排、右侧填满。 -->
        <Grid Grid.Row="1" Padding="32,4,32,28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 标题 -->
            <StackPanel Grid.Row="0" Spacing="6">
                <TextBlock Text="ShittimLogon 发送端"
                           Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock Text="监听端口，把准备好的安装包按需分发给客户端"
                           Style="{StaticResource BodyTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap" />
            </StackPanel>

            <!-- 分发文件 -->
            <StackPanel Grid.Row="1" Spacing="6" Margin="0,18,0,0">
                <TextBlock Text="分发文件"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="FileBox" Grid.Column="0" />
                    <Button x:Name="BrowseButton"
                            Grid.Column="1"
                            Content="浏览…"
                            Margin="8,0,0,0"
                            Click="OnBrowseClicked" />
                </Grid>
                <TextBlock Text="客户端按相对路径请求这个文件；所在目录内的其它文件同样可被请求。"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap" />
            </StackPanel>

            <!-- 端口与操作 -->
            <StackPanel Grid.Row="2" Spacing="6" Margin="0,18,0,0">
                <TextBlock Text="监听端口"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <NumberBox x:Name="PortBox"
                               Value="50304"
                               MinWidth="150"
                               SpinButtonPlacementMode="Compact" />
                    <Button x:Name="StartButton"
                            Content="开始监听"
                            Style="{StaticResource AccentButtonStyle}"
                            MinWidth="112"
                            Click="OnStartClicked" />
                    <Button x:Name="StopButton"
                            Content="停止"
                            MinWidth="112"
                            IsEnabled="False"
                            Click="OnStopClicked" />
                </StackPanel>
            </StackPanel>

            <!-- 状态 -->
            <StackPanel Grid.Row="3" Spacing="6" Margin="0,18,0,0">
                <TextBlock x:Name="StatusText"
                           Text="未监听"
                           Style="{StaticResource BodyTextBlockStyle}"
                           TextWrapping="Wrap" />
                <TextBlock x:Name="TransferText"
                           Text=""
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap" />
            </StackPanel>

            <!-- 统计 -->
            <Border Grid.Row="4"
                    Margin="0,16,0,0"
                    Padding="16,12"
                    CornerRadius="8"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Text="当前连接"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="ConnectionsText"
                                   Text="0"
                                   Style="{StaticResource SubtitleTextBlockStyle}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock Text="已完成传输"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="TransfersText"
                                   Text="0"
                                   Style="{StaticResource SubtitleTextBlockStyle}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="2">
                        <TextBlock Text="累计发送"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="BytesText"
                                   Text="0 B"
                                   Style="{StaticResource SubtitleTextBlockStyle}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 日志 -->
            <TextBlock Grid.Row="5"
                       Text="日志"
                       Margin="0,18,0,6"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

            <Border Grid.Row="6"
                    CornerRadius="8"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <ListView x:Name="LogList"
                          Padding="4"
                          SelectionMode="None"
                          IsItemClickEnabled="False">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <TextBlock Text="{x:Bind}" TextWrapping="Wrap" />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>
        </Grid>
    </Grid>
</Window>
