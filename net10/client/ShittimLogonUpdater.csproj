<!--
  ShittimLogon 更新器 —— WinUI 3 / Windows App SDK（.NET 10）

  这是主推版本：原生 Win11 界面（Mica 云母背景、圆角窗口、跟随系统的明暗主题与
  强调色、自定义标题栏、过渡动画）。

  部署方式：自包含。
    SelfContained=true                .NET 运行时打进输出目录
    WindowsAppSDKSelfContained=true   Windows App SDK 运行时打进输出目录
  目标机器不需要预装任何运行时，整个输出目录拷过去双击即可 —— 对「更新器」这种
  要在干净机器上跑的工具是必须的。代价是目录约 100 MB。

  产物：net10\dist\（单文件版 + winui-x64\ 目录版）
  自包含目录有上百个文件，所以单独成目录，不铺在仓库根目录。

  构建：net10\client\build.bat   或   dotnet build
-->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>ShittimLogonUpdater</RootNamespace>
    <AssemblyName>ShittimLogonUpdater</AssemblyName>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>

    <!-- 自包含：目标机器零依赖 -->
    <SelfContained>true</SelfContained>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>

    <!-- Unpackaged：不打包成 MSIX，直接运行 exe -->
    <WindowsPackageType>None</WindowsPackageType>

    <!--
      单文件发布需要它：Windows App SDK 的 SingleFile.targets 会强制检查这一项，
      缺了直接报错 "PublishSingleFile requires EnableMsixTooling for embedded
      resources.pri generation"。开启后 PRI 资源会被嵌进 exe，而不是散落成
      resources.pri 文件 —— 这正是单文件运行所必需的。
      注意这与 WindowsPackageType=None 并不冲突：这里只是借用它的 PRI 生成能力，
      并不会把应用变成 MSIX 包。
    -->
    <EnableMsixTooling>true</EnableMsixTooling>

    <!-- 版本与产品信息写在 AssemblyInfo.cs 里，别让 SDK 再生成一份 -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>

    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- 自包含产出上百个文件，单独放 dist\，不铺在仓库根目录 -->
    <OutputPath>$(MSBuildThisFileDirectory)..\dist\winui-x64\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
  </ItemGroup>

  <!--
    剔除 AI/ML 组件。

    Windows App SDK 2.x 的总包会把整套 AI 栈一并拉进来：
      Microsoft.WindowsAppSDK.AI / .ML / Microsoft.Windows.AI.MachineLearning
    它们在自包含产物里贡献了 onnxruntime.dll (20.7 MB)、DirectML.dll (17.8 MB)、
    System.Numerics.Tensors 等约 38 MB —— 对一个「下载、解压、运行安装包」的
    更新器完全用不上。

    总包的 targets 里没有提供精简开关，因此显式声明这些包并把资产全部排除，
    让它们不再复制到输出目录。版本号与当前解析结果一致；升级 Windows App SDK
    后若这里出现版本冲突，用 dotnet list package 命令（附带 include-transitive
    参数）查到新版本号同步即可。
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK.AI" Version="2.5.5" ExcludeAssets="all" PrivateAssets="all" />
    <PackageReference Include="Microsoft.WindowsAppSDK.ML" Version="2.1.94" ExcludeAssets="all" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Windows.AI.MachineLearning" Version="2.1.74" ExcludeAssets="all" PrivateAssets="all" />
  </ItemGroup>

</Project>
